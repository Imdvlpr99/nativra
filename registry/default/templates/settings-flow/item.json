{
  "id": "settings-flow",
  "name": "Settings Flow",
  "description": "A comprehensive mobile settings screen template with account profile header, preference toggles, security options, and logout dialog.",
  "type": "template",
  "status": "stable",
  "version": "0.1.0",
  "stylingTargets": ["nativewind", "stylesheet"],
  "platforms": {
    "android": true,
    "ios": true,
    "web": true,
    "expoGo": true
  },
  "files": [
    {
      "path": "nativewind/SettingsFlow.tsx",
      "target": "nativewind"
    },
    {
      "path": "stylesheet/SettingsFlow.tsx",
      "target": "stylesheet"
    }
  ],
  "registryDependencies": [
    { "id": "avatar", "registry": "default" },
    { "id": "card", "registry": "default" },
    { "id": "switch", "registry": "default" },
    { "id": "separator", "registry": "default" },
    { "id": "button", "registry": "default" }
  ],
  "npmDependencies": [],
  "tags": ["template", "settings", "preferences", "account", "profile", "flow"],
  "docsPath": "docs.mdx",
  "addedAt": "2024-01-01T00:00:00.000Z"
}

