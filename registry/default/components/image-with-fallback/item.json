{
  "id": "image-with-fallback",
  "name": "ImageWithFallback",
  "description": "An image with a skeleton while it loads and a themed fallback when it fails or has no source.",
  "type": "component",
  "status": "beta",
  "version": "0.1.0",
  "stylingTargets": ["nativewind", "stylesheet"],
  "platforms": { "android": true, "ios": true, "expoGo": true },
  "files": [
    { "path": "nativewind/ImageWithFallback.tsx", "target": "nativewind" },
    { "path": "stylesheet/ImageWithFallback.tsx", "target": "stylesheet" }
  ],
  "registryDependencies": [
    { "id": "skeleton", "registry": "default" },
    { "id": "use-theme-colors", "registry": "default" }
  ],
  "npmDependencies": [
    { "package": "lucide-react-native", "version": "^1.73.0" },
    { "package": "react-native-svg", "version": "^15.8.0" }
  ],
  "tags": ["image", "media", "loading"],
  "docsPath": "docs.mdx",
  "addedAt": "2026-11-20T00:00:00.000Z"
}
