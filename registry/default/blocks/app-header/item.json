{
  "id": "app-header",
  "name": "App Header",
  "description": "Versatile enterprise application navigation header with branding, back navigation, search, action buttons, notifications badge, and user avatar.",
  "type": "block",
  "status": "stable",
  "version": "0.1.0",
  "stylingTargets": ["nativewind", "stylesheet"],
  "platforms": {
    "android": true,
    "ios": true,
    "web": true,
    "expoGo": true
  },
  "files": [
    {
      "path": "nativewind/AppHeader.tsx",
      "target": "nativewind"
    },
    {
      "path": "stylesheet/AppHeader.tsx",
      "target": "stylesheet"
    }
  ],
  "registryDependencies": [
    {
      "id": "avatar",
      "registry": "default"
    },
    {
      "id": "badge",
      "registry": "default"
    }
  ],
  "npmDependencies": [
    {
      "package": "lucide-react-native",
      "version": "^0.460.0"
    }
  ],
  "tags": ["header", "navigation", "search", "notifications", "branding", "enterprise", "metronic"],
  "docsPath": "docs.mdx",
  "addedAt": "2024-01-01T00:00:00.000Z"
}

