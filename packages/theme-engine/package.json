{
  "name": "@nativra/theme-engine",
  "version": "0.2.2",
  "description": "Token model and NativeWind/StyleSheet adapter for Nativra themes",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0",
    "rimraf": "^6.0.1"
  },
  "license": "MIT",
  "homepage": "https://nativra.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imdvlpr99/nativra.git",
    "directory": "packages/theme-engine"
  },
  "bugs": {
    "url": "https://github.com/Imdvlpr99/nativra/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
