{
  "name": "@nativra/registry-builder",
  "version": "0.0.1",
  "description": "Builds authored registry source files into deployable registry.json + per-item JSON",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nativra/registry-schema": "workspace:*",
    "@nativra/utils": "workspace:*"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
