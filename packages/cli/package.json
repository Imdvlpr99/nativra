{
  "name": "nativra-cli",
  "version": "0.2.3",
  "description": "Nativra CLI — add, update, diff, and manage UI components in your React Native project",
  "license": "MIT",
  "type": "module",
  "homepage": "https://nativra.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imdvlpr99/nativra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Imdvlpr99/nativra/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "nativewind",
    "ui",
    "components",
    "shadcn",
    "nativra",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "nativra": "dist/cli.js",
    "nativra-cli": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "@nativra/registry-client": "workspace:*",
    "@nativra/registry-schema": "workspace:*",
    "@nativra/theme-engine": "workspace:*",
    "@nativra/utils": "workspace:*",
    "@types/prompts": "^2.4.9",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0",
    "rimraf": "^6.0.1"
  }
}
