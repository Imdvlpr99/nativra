{
  "name": "@nativra/cli",
  "version": "0.0.1",
  "description": "Nativra CLI — add, update, diff, and manage UI components in your React Native project",
  "type": "module",
  "bin": {
    "nativra": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nativra/registry-schema": "workspace:*",
    "@nativra/registry-client": "workspace:*",
    "@nativra/utils": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "fs-extra": "^11.2.0",
    "diff": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "@types/prompts": "^2.4.9",
    "@types/fs-extra": "^11.0.4",
    "@types/diff": "^7.0.0",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
