    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
