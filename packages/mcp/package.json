{
  "name": "nativra-mcp",
  "version": "0.4.0",
  "description": "MCP server for Nativra: lets AI agents search, inspect and install React Native components",
  "license": "MIT",
  "type": "module",
  "homepage": "https://nativra.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imdvlpr99/nativra.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Imdvlpr99/nativra/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
