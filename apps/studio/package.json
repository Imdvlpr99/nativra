{
  "name": "@nativra/studio",
  "version": "0.0.1",
  "private": true,
  "description": "Nativra Studio — visual component editor and prop inspector",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out",
    "prebuild": "node ../../scripts/build-registry.mjs",
    "predev": "node ../../scripts/build-registry.mjs"
  },
  "dependencies": {
    "@nativra/registry-schema": "workspace:*",
    "@nativra/registry-client": "workspace:*",
    "@nativra/studio-schema": "workspace:*",
    "@nativra/theme-engine": "workspace:*",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "@nativra/codegen": "workspace:*"
  },
  "devDependencies": {
    "@nativra/config": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "rimraf": "^6.0.1"
  }
}
