{
  "name": "@nativra/native-preview",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "description": "Expo app used to verify Nativra components on Android/iOS",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "sync": "node scripts/sync-components.mjs",
    "typecheck": "node scripts/sync-components.mjs && tsc --noEmit && node scripts/check-nativewind.mjs",
    "typecheck:nativewind": "node scripts/check-nativewind.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@expo/metro-runtime": "~58.0.17",
    "@nativra/preview-runtime": "workspace:*",
    "@tailwindcss/browser": "4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.25",
    "expo-haptics": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "sucrase": "^3.35.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "nativewind": "^4.2.7",
    "typescript": "~6.0.3"
  }
}
