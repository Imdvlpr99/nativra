{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Pin "react" to this app's own @types/react, so dependencies without their own copy
    // (lucide-react-native) can't pick up a different hoisted version (apps/docs pins its own).
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".nativewind-check"]
}
