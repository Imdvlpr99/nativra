{
  "expo": {
    "name": "Nativra Preview",
    "slug": "nativra-preview",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.nativra.preview"
    },
    "android": {
      "package": "dev.nativra.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/preview"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The preview uses the camera to demo the code scanner."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The preview opens your photos to demo the image picker.",
          "cameraPermission": "The preview uses the camera to demo the image picker."
        }
      ]
    ]
  }
}
